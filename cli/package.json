{
  "name": "nginx-proxy-cli",
  "version": "4.0.2",
  "description": "CLI for deploying docker-compose applications using the nginx-proxy (https://nginxproxy.lars-rickert.de).",
  "main": "bin/index.js",
  "author": "larsrickert",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larsrickert/nginx-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/larsrickert/nginx-proxy/issues"
  },
  "homepage": "https://nginxproxy.lars-rickert.de",
  "files": [
    "bin",
    "public",
    "package.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "bin": {
    "nginx-proxy-cli": "./bin/index.js"
  },
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc",
    "nginx-proxy-cli": "nginx-proxy-cli",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "shelljs": "~0.10.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@types/shelljs": "~0.10.0",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "typescript": "~6.0.3"
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "main",
      "next",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "pnpm build"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  }
}
