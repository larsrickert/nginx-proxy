{
  "name": "nginx-proxy-docs",
  "version": "1.0.0",
  "description": "Combination of Open Source tools that enable you to easily deploy any application that runs with Docker on your own linux server.",
  "author": "larsrickert",
  "license": "MIT",
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/larsrickert/nginx-proxy"
  },
  "homepage": "https://nginxproxy.lars-rickert.de",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "serve": "vitepress serve docs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@sit-onyx/vitepress-theme": "^1.1.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "vite": "^8.3.8",
    "vitepress": "2.0.0-alpha.21"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write -u"
  }
}
