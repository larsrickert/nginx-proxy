{
  "name": "nginx-proxy-docs",
  "version": "1.0.0",
  "description": "Combination of Open Source tools that enable you to easily deploy any application that runs with Docker on your own linux server.",
  "author": "larsrickert",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/larsrickert/nginx-proxy"
  },
  "homepage": "https://nginxproxy.lars-rickert.de",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "serve": "vitepress serve docs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@sit-onyx/vitepress-theme": "^1.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "vite": "^8.3.5",
    "vitepress": "2.0.0-alpha.20"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write -u"
  }
}
